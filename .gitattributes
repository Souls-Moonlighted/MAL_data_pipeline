# Text file
* text=auto eol=lf

# Source code
*.py          text eol=lf diff=python

# Config, container
*.json        text eol=lf
*.jsonl       text eol=lf
*.xml         text eol=lf
*.yaml        text eol=lf
*.toml        text eol=lf
*.yml         text eol=lf
*.ini         text eol=lf

# Enviroment
.env          text eol=lf
*.env         text eol=lf

# Documents
*.md          text eol=lf

# Linux / POSIX shell scripts
*.sh          text eol=lf
*.bash        text eol=lf
*.zsh         text eol=lf

# Windows shell scripts
*.bat         text eol=crlf
*.cmd         text eol=crlf

# Binary files
*.png         binary
*.jpg         binary
*.jpeg        binary
*.tar.gz      binary
*.zip         binary
*.tar.gz      binary
*.parquet     binary
*.pdf         binary